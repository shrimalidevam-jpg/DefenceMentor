# Application
APP_NAME=NDA Chatbot API
APP_ENV=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql://nda_user:nda_password@localhost:5432/nda_chatbot

# Security (change these in production)
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Mastery scoring
MASTERY_THRESHOLD=80
MASTERY_RECENCY_WEIGHT=0.15

# Adaptive assessment
ADAPTIVE_HIGH_THRESHOLD=0.8
ADAPTIVE_MEDIUM_THRESHOLD=0.5
ADAPTIVE_QUESTIONS_PER_ROUND=5

# Choose gemini-free (requires an AI Studio project with billing not linked), ollama, or disabled.
AI_PROVIDER=gemini-free
GEMINI_FREE_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_BASE_URL=http://127.0.0.1:11434
AI_TIMEOUT_SECONDS=30

# CORS (frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173

# Google Identity Services web client ID
GOOGLE_CLIENT_ID=

# Local report schedule and WhatsApp Cloud API.
# Reports run Sunday and on the last day of each month at 18:00 APP_TIMEZONE.
APP_TIMEZONE=Asia/Kolkata
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=nda_progress_report
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v22.0
